# Application
ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Neon PostgreSQL — paste your connection string from Neon dashboard
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# CORS — comma-separated origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000,https://your-portfolio.vercel.app

# SMTP (Gmail: use App Password, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pavanmannem42@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM=pavanmannem42@gmail.com
CONTACT_TO_EMAIL=pavanmannem42@gmail.com
